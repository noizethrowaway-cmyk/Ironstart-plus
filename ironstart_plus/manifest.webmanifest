{
  "id": "./",
  "name": "IronStart Workout Planner",
  "short_name": "IronStart",
  "description": "Offline-first strength training planner with progression, rest cues and workout history.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
